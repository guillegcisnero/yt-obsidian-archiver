# ============================================================
#  YT Obsidian & Course Archiver - Plantilla de configuración
# ============================================================
#  1. Copia este archivo como ".env" (en esta misma carpeta Servidor/).
#  2. Ajusta los valores a tu PC.
#  3. El servidor carga el .env automáticamente al arrancar.
#     (Si una variable no está definida aquí, se usa el valor por defecto.)

# --- Seguridad -------------------------------------------------
# Debe coincidir EXACTAMENTE con la constante AUTH_TOKEN de extension/popup.js
YT_AUTH_TOKEN=MI_CLAVE_SECRETA_BLINDADA_2026

# --- Servidor --------------------------------------------------
# HOST=127.0.0.1 blinda el servidor: nadie de tu red Wi-Fi/LAN puede acceder.
# Si lo cambias a 0.0.0.0 expondrás el servidor a la red (no recomendado).
YT_HOST=127.0.0.1
YT_PORT=8000

# Espacio libre mínimo (GB) exigido antes de aceptar descargas de video.
YT_MIN_FREE_DISK_GB=5.0

# --- Evasión de bloqueos de YouTube (opcional) -----------------
# Navegador del que copiar las cookies para saltar verificaciones de bot/edad
# o errores "HTTP 429 Too Many Requests". Vacío = desactivado.
# Valores válidos: chrome | firefox | edge | brave | chromium | opera | vivaldi | safari
YT_COOKIES_FROM_BROWSER=

# --- Carpetas de destino ---------------------------------------
# Admite rutas absolutas (C:\Users\TuUsuario\...) o con ~ (se expande al home).
# Se crean automáticamente si no existen.
YT_DEST_OBSIDIAN=~/Documents/ObsidianVault/Cursos_YouTube
YT_DEST_GDRIVE=~/Google Drive/Cursos_YouTube
YT_DEST_ONEDRIVE=~/OneDrive/Cursos_YouTube
YT_DEST_LOCAL=~/Downloads/Cursos_YouTube

# --- Notas -----------------------------------------------------
# * FFmpeg debe estar en el PATH para unir MP4/MKV, convertir a MP3 y dividir por capítulos.
# * yt-dlp recomienda un runtime JS (deno) para YouTube moderno; sin él avisa que
#   "algunos formatos pueden faltar": https://github.com/yt-dlp/yt-dlp/wiki/EJS
# * Si YouTube responde "HTTP 429 Too Many Requests" o pide verificación de bot,
#   configura YT_COOKIES_FROM_BROWSER=chrome (ver sección de evasión de bloqueos).
