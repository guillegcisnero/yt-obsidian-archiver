{
  "manifest_version": 3,
  "name": "YT Obsidian & Course Archiver",
  "version": "1.1",
  "description": "Extrae transcripciones de cursos de YouTube a Markdown (Obsidian) y descarga videos largos con cola de espera.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Obsidian & Course Archiver",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}